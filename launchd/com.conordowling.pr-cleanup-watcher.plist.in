<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.conordowling.pr-cleanup-watcher</string>
  <key>ProgramArguments</key><array><string>__HOME__/.local/bin/pr-cleanup-watcher.sh</string></array>
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__HOME__/.local/state/pr-cleanup-watcher/watcher.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.local/state/pr-cleanup-watcher/watcher.log</string>
</dict></plist>
