<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.conordowling.automations-sync</string>
  <key>ProgramArguments</key><array><string>__REPO__/install.sh</string><string>--sync</string></array>
  <key>WatchPaths</key><array>
__WATCH_PATHS__
  </array>
  <key>AbandonProcessGroup</key><true/>
  <key>StandardOutPath</key><string>__HOME__/.local/state/automations/sync.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.local/state/automations/sync.log</string>
</dict></plist>
