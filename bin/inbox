#!/bin/bash
# The inbox CLI (see docs/plans/2026-11-27-inbox-design.md).
#   inbox open [--port N]   focus the pinned 📥 Inbox workspace, creating it if needed
#   inbox post <ref> "<text>" [--source NAME] [--notify]
#                           add an update to a workstream. <ref> is a ticket (PERS-123),
#                           repo#num, owner/repo#num or a PR URL. Writes the inbox db
#                           directly, so it works while the server is down. --notify also
#                           sends a cmux and macOS notification.
# Read to the end before running, so editing this file mid-run can't break the run.
{
set -u
export CMUX_QUIET=1
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
CM=/Applications/cmux.app/Contents/Resources/bin/cmux
NAME="📥 Inbox"

cmd_open() {
  local port=${INBOX_PORT:-8765}
  [ "${1:-}" = "--port" ] && port=$2
  export CMUX_SOCKET_PATH
  CMUX_SOCKET_PATH=$(cat "$HOME/Library/Application Support/cmux/last-socket-path" 2>/dev/null)
  "$CM" ping >/dev/null 2>&1 || { echo "cmux not reachable" >&2; return 1; }
  local ws
  ws=$("$CM" workspace list 2>/dev/null | awk -v t="$NAME" '{id=$1; if ($1=="*") id=$2; line=$0; sub(/^[* ] *[^ ]+ +/,"",line); sub(/ +\[selected\]$/,"",line); if (line==t) {print id; exit}}')
  if [ -z "$ws" ]; then
    local layout out
    layout=$(jq -nc --arg url "http://localhost:$port/" '{pane:{surfaces:[{type:"browser",url:$url}]}}')
    out=$("$CM" new-workspace --name "$NAME" --layout "$layout" --focus true 2>&1) || { echo "$out" >&2; return 1; }
    ws=$(echo "$out" | awk '/^OK/ {print $2}')
    "$CM" workspace-action --workspace "$ws" --action pin >/dev/null 2>&1
    "$CM" workspace-action --workspace "$ws" --action move-top >/dev/null 2>&1
  fi
  "$CM" workspace select "$ws" >/dev/null
}

cmd_post() {
  local ref="" text="" source="agent" notify=""
  while [ $# -gt 0 ]; do
    case $1 in
      --source) source=$2; shift 2 ;;
      --notify) notify=1; shift ;;
      *) if [ -z "$ref" ]; then ref=$1; elif [ -z "$text" ]; then text=$1; else echo "inbox post: unexpected '$1'" >&2; return 2; fi; shift ;;
    esac
  done
  [ -n "$ref" ] && [ -n "$text" ] || { echo 'usage: inbox post <ref> "<text>" [--source NAME] [--notify]' >&2; return 2; }
  local where
  where=$(/opt/homebrew/bin/python3 - "$ref" "$text" "$source" <<'PY'
import re, sqlite3, subprocess, sys
from datetime import datetime, timezone
from pathlib import Path
import os

ref, text, source = sys.argv[1:4]
db = sqlite3.connect(os.environ.get("INBOX_DB", Path.home() / ".local/state/inbox/inbox.db"), timeout=5)
db.execute("pragma busy_timeout=5000").fetchall()
ticket = re.fullmatch(r"[A-Z][A-Z0-9]*-\d+", ref)
m = re.search(r"(?:github\.com/)?(?:([\w.-]+)/)?([\w.-]+)(?:#|/pull/)(\d+)", ref)
if ticket:
    workstream, pr_ref = ref, None
elif m:
    owner, repo, num = m.group(1) or "klaviyo", m.group(2), m.group(3)
    pr_ref = f"{repo}#{num}"
    row = db.execute("select workstream from prs where ref = ?", (pr_ref,)).fetchone()
    if row:
        workstream = row[0]
    elif db.execute("select 1 from reviews where ref = ?", (pr_ref,)).fetchone():
        workstream = f"review:{pr_ref}"
    else:  # not polled yet: same rule as the server, from the PR title
        title = subprocess.run(["gh", "pr", "view", num, "-R", f"{owner}/{repo}", "--json", "title", "-q", ".title"],
                               capture_output=True, text=True).stdout.strip()
        t = re.match(r"^\[?([A-Z][A-Z0-9]*-\d+)\]?", title)
        workstream = t.group(1) if t and not t.group(1).endswith("-TBD") else f"pr:{pr_ref}"
else:
    sys.exit(f"inbox post: can't read '{ref}' as a ticket or PR")
db.execute("insert into events (workstream, pr_ref, source, text, created_at) values (?,?,?,?,?)",
           (workstream, pr_ref, source, text, datetime.now(timezone.utc).isoformat(timespec="seconds")))
db.commit()
print(pr_ref or workstream)
PY
) || return 1
  if [ -n "$notify" ]; then
    export CMUX_SOCKET_PATH
    CMUX_SOCKET_PATH=$(cat "$HOME/Library/Application Support/cmux/last-socket-path" 2>/dev/null)
    "$CM" notify --title "$source: $where" --body "$text" >/dev/null 2>&1
    osascript -e "display notification \"${text//\"/\\\"}\" with title \"$source: $where\"" >/dev/null 2>&1
  fi
  return 0
}

case ${1:-} in
  open) shift; cmd_open "$@" ;;
  post) shift; cmd_post "$@" ;;
  *) echo "usage: inbox open [--port N] | inbox post <ref> \"<text>\" [--source NAME] [--notify]" >&2; exit 2 ;;
esac
exit
}
